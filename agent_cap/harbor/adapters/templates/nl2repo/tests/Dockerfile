# Verifier image for NL2Repo task @@TASK@@ (generated by agent_cap.harbor.adapters).
#
# Built from the official NL2RepoBench evaluation image. That image's /workspace
# holds the hidden tests and the original pyproject.toml, so it is moved out of
# /workspace here; nl2repo_eval.py overlays the agent's submission on it at
# grading time, as upstream's post_processor does. The agent never runs in this
# image: its container is built from environment/Dockerfile.
FROM --platform=linux/amd64 @@EVAL_IMAGE@@

RUN mkdir -p /opt/nl2repo \
 && cp -a /workspace /opt/nl2repo/reference \
 && find /workspace -mindepth 1 -delete

ENV PYTHONPATH=/workspace
WORKDIR /workspace

# Bundled tests: Harbor runs /tests/test.sh in this image.
COPY test.sh nl2repo_eval.py meta.json /tests/
RUN chmod +x /tests/test.sh
