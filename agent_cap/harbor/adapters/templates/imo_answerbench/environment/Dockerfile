# Task environment for IMO-AnswerBench (generated by agent_cap.harbor.adapters).
#
# Holds the Python stack behind CAPAgent's `python` tool (a persistent Jupyter
# kernel) and math-verify for the shared-mode verifier. Versions match the
# AgentCAP host environment the TEAS runs were validated with.
FROM python:3.12-slim-bookworm

RUN pip install --no-cache-dir \
        "ipykernel==7.4.0" \
        "jupyter_client==8.10.0" \
        "mpmath==1.3.0" \
        "sympy==1.14.0" \
        "numpy==2.5.5" \
        "math-verify==0.9.0" \
        "latex2sympy2_extended==1.11.0" \
        "antlr4-python3-runtime==4.13.2" \
    && apt-get update \
    && apt-get install -y --no-install-recommends procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
